# Review the attributes below. Anything personal or secret should be overridden
# with a method of the same name, for example:
#
#   def email
#     "user#{id}@example.com"
#   end
class <%= freezer_class_name %> < DeepFreezer::Base
<% freezer_attributes.each_with_index do |attribute, index| -%>
  <%= index.zero? ? "freeze" : "      " %> :<%= attribute %><%= "," unless index == freezer_attributes.size - 1 %>
<% end -%>
end
